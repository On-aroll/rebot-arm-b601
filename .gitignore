# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# ── 第三方仓库：只留我们改过的 fork 源码，其余按 configs/external-manifest.json 重建 ──
external/*
!external/motorbridge-studio/
external/motorbridge-studio/node_modules/
external/motorbridge-studio/dist/
external/motorbridge-studio/.git/
external/motorbridge-studio/.vite/
external/motorbridge-studio/coverage/

# ── 运行产物：日志、进程号、任务落盘 ──────────────────────────────────────
outputs/*.log
outputs/*.pid
outputs/*.jsonl
outputs/*.tmp
outputs/machine_live.json
outputs/jobs/
outputs/writing-tests/
outputs/program-tests/

# ── 大体积演示产物（视频与图片，单文件常达数 MB）────────────────────────
outputs/*.mp4
outputs/*.png
outputs/*.jpg
outputs/*.ppm
refs/

# ── 本机环境与缓存，不属于项目内容 ───────────────────────────────────────
downloads/
.ros/
.Trash-0/
.workbuddy-ai/
.qoder_*
.DS_Store
Thumbs.db

# ── 本地覆盖与凭据：绝不入库 ─────────────────────────────────────────────
.env
*.local
*.token
*.pem
*.key

# Private software profiles, snapshots, approvals and backups
outputs/private_config/
outputs/startup/
outputs/instances/
.venv-sim/

# Reproducible P4 scratch runs; selected evidence lives in docs/validation/mit-p4
outputs/mit-p4/

# Local single-axis operator trial records (not configuration backups)
outputs/mit-p5/
outputs/mit-p6/
